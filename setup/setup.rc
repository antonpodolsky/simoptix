OPENXR_LAYER_DLL RCDATA "..\\vr_mirror\\frame_sources\\openxr\\bin\\XR_APILAYER_SIMOPTIX_frame_source.dll"
OPENXR_LAYER_JSON RCDATA "..\\vr_mirror\\frame_sources\\openxr\\bin\\XR_APILAYER_SIMOPTIX_frame_source.json"
